<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp" android:background="#0b1020">

    <TextView android:id="@+id/tvStatus" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="未连接" android:textColor="#94a3b8" android:textSize="14sp" android:padding="6dp"/>

    <Button android:id="@+id/btnScan" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="🔍 搜索附近蓝牙设备" android:backgroundTint="#243049" android:textColor="#e5e7eb"/>

    <ListView android:id="@+id/listDevices" android:layout_width="match_parent" android:layout_height="120dp"
        android:background="#1a2032" android:layout_marginTop="6dp" android:visibility="gone"/>

    <!-- 遥测仪表 -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="10dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:background="#141a2e" android:padding="14dp"
            android:layout_marginEnd="6dp" android:gravity="center">
            <TextView android:text="实时速度" android:textColor="#8a96b2" android:textSize="12sp"/>
            <TextView android:id="@+id/tvSpeed" android:text="0.0" android:textColor="#e6edf7"
                android:textSize="30sp" android:textStyle="bold"/>
            <TextView android:text="cm/s" android:textColor="#8a96b2" android:textSize="12sp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:background="#141a2e" android:padding="14dp"
            android:layout_marginStart="6dp" android:gravity="center">
            <TextView android:text="总里程" android:textColor="#8a96b2" android:textSize="12sp"/>
            <TextView android:id="@+id/tvDist" android:text="0.00" android:textColor="#f59e0b"
                android:textSize="30sp" android:textStyle="bold"/>
            <TextView android:text="米 (m)" android:textColor="#8a96b2" android:textSize="12sp"/>
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/tvRaw" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="脉冲/s: --" android:textColor="#8a96b2" android:textSize="11sp" android:layout_marginTop="4dp"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="10dp">
        <Button android:id="@+id/btnAuto" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="🤖 自动避障" android:backgroundTint="#243049" android:textColor="#e5e7eb"/>
        <Button android:id="@+id/btnManual" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginLeft="8dp" android:text="✋ 手动控制"
            android:backgroundTint="#2dd4bf" android:textColor="#04211f"/>
    </LinearLayout>
    <TextView android:id="@+id/tvMode" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="当前：手动模式（按住方向键控制）" android:textColor="#94a3b8" android:textSize="12sp"
        android:layout_marginTop="4dp"/>

    <GridLayout android:id="@+id/dpad" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center" android:rowCount="3" android:columnCount="3" android:layout_marginTop="16dp">
        <Button android:id="@+id/btnF" android:text="▲" android:layout_row="0" android:layout_column="1"
            android:layout_width="90dp" android:layout_height="90dp" android:backgroundTint="#1a2032" android:textColor="#e5e7eb" android:textSize="28sp"/>
        <Button android:id="@+id/btnL" android:text="◀" android:layout_row="1" android:layout_column="0"
            android:layout_width="90dp" android:layout_height="90dp" android:backgroundTint="#1a2032" android:textColor="#e5e7eb" android:textSize="28sp"/>
        <Button android:id="@+id/btnS" android:text="STOP" android:layout_row="1" android:layout_column="1"
            android:layout_width="90dp" android:layout_height="90dp" android:backgroundTint="#ef4444" android:textColor="#fff" android:textSize="14sp"/>
        <Button android:id="@+id/btnR" android:text="▶" android:layout_row="1" android:layout_column="2"
            android:layout_width="90dp" android:layout_height="90dp" android:backgroundTint="#1a2032" android:textColor="#e5e7eb" android:textSize="28sp"/>
        <Button android:id="@+id/btnB" android:text="▼" android:layout_row="2" android:layout_column="1"
            android:layout_width="90dp" android:layout_height="90dp" android:backgroundTint="#1a2032" android:textColor="#e5e7eb" android:textSize="28sp"/>
    </GridLayout>

    <Button android:id="@+id/btnStop" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="■ 急停" android:backgroundTint="#ef4444" android:textColor="#fff" android:layout_marginTop="12dp"/>

    <TextView android:id="@+id/tvLog" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:textColor="#94a3b8" android:textSize="11sp"
        android:background="#1a2032" android:padding="8dp" android:layout_marginTop="8dp"/>
</LinearLayout>
